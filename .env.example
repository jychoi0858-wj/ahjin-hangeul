# 이 파일을 복사해서 ".env.local" 로 만들고 값을 채우세요.
# (.env.local 은 git에 올라가지 않습니다)

# ── Firebase (Firestore + Auth) ─────────────────────────────
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ── Azure Speech (선택: Firestore에 키를 안 둘 때만 사용) ──────
# 실제 운영은 Firestore config/azure 문서에 저장하는 것을 권장.
# 로컬에서 빠르게 테스트할 때만 아래 두 값을 채우세요.
REACT_APP_AZURE_SPEECH_KEY=
REACT_APP_AZURE_SPEECH_REGION=
